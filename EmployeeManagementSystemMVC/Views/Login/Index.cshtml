@model EmployeeManagementSystemMVC.Models.Login

@{
    ViewData["Title"] = "Login";
}

<style>

    /* =========================================
           LOGIN PAGE
        ========================================= */

    .login-page {
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa, #e4e8f0);
        animation: pageFadeIn 0.8s ease-in-out;
    }


    /* =========================================
           LOGIN CARD
        ========================================= */

    .login-card {
        border: none;
        border-radius: 20px;
        animation: cardSlideUp 0.8s ease-out;
        transition: all 0.3s ease;
    }

        .login-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15) !important;
        }


    /* =========================================
           LOGIN TITLE
        ========================================= */

    .login-title {
        font-weight: 700;
        color: #212529;
        animation: titleFade 1s ease-in-out;
    }


    /* =========================================
           FORM INPUT
        ========================================= */

    .login-input {
        height: 50px;
        border-radius: 10px;
        transition: all 0.3s ease;
    }

        .login-input:focus {
            transform: scale(1.02);
            border-color: #0d6efd;
            box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.15);
        }


    /* =========================================
           LOGIN BUTTON
        ========================================= */

    .login-button {
        height: 50px;
        border-radius: 10px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .login-button:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(13, 110, 253, 0.3);
        }

        .login-button:active {
            transform: scale(0.97);
        }


    /* =========================================
           ERROR MESSAGE
        ========================================= */

    .login-error {
        border-radius: 10px;
        animation: errorShake 0.5s ease-in-out;
    }


    /* =========================================
           ANIMATIONS
        ========================================= */

    @@keyframes pageFadeIn {

        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }


    @@keyframes cardSlideUp {

        from {
            opacity: 0;
            transform: translateY(60px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    @@keyframes titleFade {

        from {
            opacity: 0;
            transform: translateY(-20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    @@keyframes errorShake {

        0% {
            transform: translateX(0);
        }

        25% {
            transform: translateX(-5px);
        }

        50% {
            transform: translateX(5px);
        }

        75% {
            transform: translateX(-5px);
        }

        100% {
            transform: translateX(0);
        }
    }


    /* =========================================
           MOBILE RESPONSIVE
        ========================================= */

    @@media (max-width: 576px) {

        .login-page {
            padding: 20px 15px !important;
        }

        .login-card {
            border-radius: 15px;
            padding: 25px !important;
        }

        .login-title {
            font-size: 26px;
        }

        .login-input {
            height: 48px;
            font-size: 16px;
        }

        .login-button {
            height: 48px;
        }
    }


    /* =========================================
           SMALL MOBILE
        ========================================= */

    @@media (max-width: 360px) {

        .login-page {
            padding: 15px 10px !important;
        }

        .login-card {
            padding: 20px !important;
        }

        .login-title {
            font-size: 24px;
        }
    }


    /* =========================================
           REDUCE MOTION
        ========================================= */

    @@media (prefers-reduced-motion: reduce) {

        .login-page,
        .login-card,
        .login-title,
        .login-error,
        .login-input,
        .login-button {
            animation: none !important;
            transition: none !important;
        }
    }

</style>


<!-- =========================================
     LOGIN PAGE
========================================= -->

<div class="container-fluid min-vh-100 d-flex align-items-center justify-content-center py-4 login-page">

    <div class="row w-100 justify-content-center">

        <!--
            Responsive Bootstrap columns

            Mobile  : 12 columns
            Small   : 10 columns
            Medium  : 6 columns
            Large   : 4 columns
        -->

        <div class="col-12 col-sm-10 col-md-6 col-lg-4">

            <!-- =========================================
                 LOGIN CARD
            ========================================= -->

            <div class="card login-card shadow p-4">

                <!-- =========================================
                     LOGIN TITLE
                ========================================= -->

                <h2 class="text-center mb-4 login-title">
                    Login
                </h2>


                <!-- =========================================
                     LOGIN FORM
                ========================================= -->

                <form method="post">

                    <!-- =========================================
                         USERNAME
                    ========================================= -->

                    <div class="mb-3">

                        <label asp-for="Username"
                               class="form-label fw-semibold">

                            Username

                        </label>

                        <input asp-for="Username"
                               class="form-control login-input"
                               placeholder="Enter username"
                               autocomplete="username" />

                        <span asp-validation-for="Username"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- =========================================
                         PASSWORD
                    ========================================= -->

                    <div class="mb-3">

                        <label asp-for="Password"
                               class="form-label fw-semibold">

                            Password

                        </label>

                        <input asp-for="Password"
                               type="password"
                               class="form-control login-input"
                               placeholder="Enter password"
                               autocomplete="current-password" />

                        <span asp-validation-for="Password"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- =========================================
                         ERROR MESSAGE
                    ========================================= -->
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger login-error"
                             role="alert">

                            @ViewBag.Error

                        </div>
                    }


                    <!-- =========================================
                         LOGIN BUTTON
                    ========================================= -->

                    <div class="d-grid mt-4">

                        <button type="submit"
                                class="btn btn-primary login-button">

                            Login

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


<!-- =========================================
     VALIDATION SCRIPTS
========================================= -->
@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}