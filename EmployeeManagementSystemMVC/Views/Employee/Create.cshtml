@model EmployeeManagementSystemMVC.Models.Employee

@{
    ViewData["Title"] = "Create Employee";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>

    /* =========================================
           PAGE
        ========================================= */

    .employee-create-page {
        min-height: 100vh;
        padding: 30px 15px;
        background: linear-gradient(135deg, #f5f7fa, #e4e8f0);
    }


    /* =========================================
           CARD ANIMATION
        ========================================= */

    .employee-card {
        border: none;
        border-radius: 15px;
        overflow: hidden;
        animation: cardAnimation 0.7s ease-out;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .employee-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15) !important;
        }


    /* =========================================
           CARD HEADER
        ========================================= */

    .employee-card-header {
        padding: 20px;
    }

        .employee-card-header h3 {
            margin: 0;
            font-weight: 600;
        }


    /* =========================================
           FORM
        ========================================= */

    .employee-form {
        animation: formFadeIn 0.9s ease-in-out;
    }

        .employee-form .form-control {
            min-height: 48px;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

            .employee-form .form-control:focus {
                transform: scale(1.01);
                border-color: #198754;
                box-shadow: 0 0 0 4px rgba(25, 135, 84, 0.15);
            }


        /* =========================================
           BUTTONS
        ========================================= */

        .employee-form .btn {
            transition: all 0.3s ease;
        }

            .employee-form .btn:hover {
                transform: translateY(-2px);
            }

            .employee-form .btn:active {
                transform: scale(0.97);
            }


    /* =========================================
           ANIMATIONS
        ========================================= */

    @@keyframes cardAnimation {

        from {
            opacity: 0;
            transform: translateY(40px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    @@keyframes formFadeIn {

        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }


    /* =========================================
           MOBILE RESPONSIVE
        ========================================= */

    @@media (max-width: 576px) {

        .employee-create-page {
            padding: 15px 10px;
        }

        .employee-card {
            border-radius: 12px;
        }

        .employee-card-header {
            padding: 16px;
        }

            .employee-card-header h3 {
                font-size: 22px;
            }

        .employee-card-body {
            padding: 20px !important;
        }

        .employee-form .form-control {
            min-height: 46px;
            font-size: 16px;
        }

        .employee-form .btn {
            width: 100%;
            margin-bottom: 10px;
        }

            .employee-form .btn:last-child {
                margin-bottom: 0;
            }
    }


    /* =========================================
           VERY SMALL MOBILE
        ========================================= */

    @@media (max-width: 360px) {

        .employee-create-page {
            padding: 10px 8px;
        }

        .employee-card-body {
            padding: 15px !important;
        }

        .employee-card-header h3 {
            font-size: 20px;
        }
    }


    /* =========================================
           REDUCE MOTION
        ========================================= */

    @@media (prefers-reduced-motion: reduce) {

        .employee-card,
        .employee-form,
        .employee-form .form-control,
        .employee-form .btn {
            animation: none !important;
            transition: none !important;
        }
    }

</style>


<!-- =========================================
     CREATE EMPLOYEE PAGE
========================================= -->

<div class="container-fluid employee-create-page">

    <div class="container">

        <div class="row justify-content-center">

            <!--
                Desktop : 8 columns
                Tablet  : 10 columns
                Mobile  : 12 columns
            -->

            <div class="col-12 col-md-10 col-lg-8 col-xl-7">

                <!-- =========================================
                     EMPLOYEE CARD
                ========================================= -->

                <div class="card employee-card shadow">


                    <!-- =========================================
                         CARD HEADER
                    ========================================= -->

                    <div class="card-header bg-success text-white employee-card-header">

                        <h3>
                            Add Employee
                        </h3>

                    </div>


                    <!-- =========================================
                         CARD BODY
                    ========================================= -->

                    <div class="card-body employee-card-body p-4">

                        <form asp-action="Create"
                              method="post"
                              class="employee-form">

                            <!-- VALIDATION SUMMARY -->

                            <div asp-validation-summary="ModelOnly"
                                 class="text-danger mb-3">
                            </div>


                            <!-- NAME -->

                            <div class="mb-3">

                                <label asp-for="Name"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="Name"
                                       class="form-control"
                                       placeholder="Enter employee name" />

                                <span asp-validation-for="Name"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- EMAIL -->

                            <div class="mb-3">

                                <label asp-for="Email"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="Email"
                                       class="form-control"
                                       placeholder="Enter email address" />

                                <span asp-validation-for="Email"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- DEPARTMENT -->

                            <div class="mb-3">

                                <label asp-for="Department"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="Department"
                                       class="form-control"
                                       placeholder="Enter department" />

                                <span asp-validation-for="Department"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- SALARY -->

                            <div class="mb-3">

                                <label asp-for="Salary"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="Salary"
                                       class="form-control"
                                       placeholder="Enter salary" />

                                <span asp-validation-for="Salary"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- BUTTONS -->

                            <div class="d-flex gap-2 mt-4">

                                <button type="submit"
                                        class="btn btn-success">

                                    Save

                                </button>

                                <a asp-action="Index"
                                   class="btn btn-secondary">

                                    Cancel

                                </a>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}