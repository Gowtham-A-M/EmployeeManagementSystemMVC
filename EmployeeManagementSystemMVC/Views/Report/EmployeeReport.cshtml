@model List<EmployeeManagementSystemMVC.Models.Employee>


<div class="container mt-4">


    <h2>
        Employee Report
    </h2>


    <a asp-action="ExportExcel"
       class="btn btn-success mb-3">

        <i class="bi bi-file-earmark-excel"></i>

        Download Excel

    </a>



    <table class="table table-bordered table-striped">


        <thead class="table-dark">

            <tr>

                <th>ID</th>
                <th>Name</th>
                <th>Email</th>
                <th>Department</th>
                <th>Salary</th>

            </tr>

        </thead>



        <tbody>

            @foreach (var emp in Model)
            {

                <tr>

                    <td>@emp.Id</td>
                    <td>@emp.Name</td>
                    <td>@emp.Email</td>
                    <td>@emp.Department</td>
                    <td>@emp.Salary</td>

                </tr>

            }

        </tbody>


    </table>


</div>